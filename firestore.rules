rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users Collection: Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Books Collection
    match /books/{bookId} {
      // Allow read if user owns the book OR if book is marked public
      allow read: if resource.data.is_public == true || (isSignedIn() && resource.data.user_id == request.auth.uid);
      
      // Allow create if authenticated and user_id matches auth.uid
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      
      // Allow update if owner
      allow update: if isSignedIn() && resource.data.user_id == request.auth.uid;
      
      // Allow delete if owner
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;

      // Subcollection: Book Pages
      match /pages/{pageId} {
        allow read: if true;
        allow write: if isSignedIn();
      }

      // Subcollection: Collaborators
      match /collaborators/{collabId} {
        allow read, write: if isSignedIn();
      }
    }

    // Shares Collection (for public lookup)
    match /shares/{shareId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Analytics Events Collection
    match /analytics_events/{eventId} {
      allow create: if true;
      allow read: if isSignedIn();
    }
  }
}
